# 数据库（开发用 SQLite，生产用 Vercel Postgres）
DATABASE_URL="file:./dev.db"

# NextAuth 密钥（生产环境必须修改，用 openssl rand -base64 32 生成）
NEXTAUTH_SECRET="change-me-to-a-random-string"
NEXTAUTH_URL="http://localhost:3000"

# GitHub OAuth（可选，用于 GitHub 登录后台）
# 在 https://github.com/settings/developers 创建 OAuth App 获取
GITHUB_ID=""
GITHUB_SECRET=""
